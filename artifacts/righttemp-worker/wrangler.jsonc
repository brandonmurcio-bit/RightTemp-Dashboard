{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "righttemp-os-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      { "name": "REFRESH_TOKEN_STORE", "class_name": "RefreshTokenStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RefreshTokenStore"] }
  ],
  "observability": { "enabled": true }
}
